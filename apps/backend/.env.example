# Copia questo file in .env e riempi i valori. Non committare mai .env.
PORT=3001

# Chiave API Anthropic (console.anthropic.com) — è ciò che fa rispondere Claude come Elayra
ANTHROPIC_API_KEY=
# Modello Claude usato da Elayra
ANTHROPIC_MODEL=claude-sonnet-5-5

# Progetto Supabase (auth + database)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Origini web autorizzate, separate da virgola (es. https://elayra.vercel.app)
ALLOWED_ORIGINS=http://localhost:4173

# Messaggi massimi per utente nelle ultime 24 ore
DAILY_MESSAGE_LIMIT=100
