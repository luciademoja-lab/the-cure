# Copia questo file in .env e riempi i valori. Non committare mai .env.
PORT=3001
# Indirizzo della web app (serve a Stripe per tornare all'app dopo il pagamento)
APP_URL=http://localhost:4173

# ── Claude ────────────────────────────────────────────────────────────────
# Chiave API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
# Modello dei piani da Part time in su
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modello economico: piano gratuito, piano Forgia e lavori di sfondo
ANTHROPIC_LIGHT_MODEL=claude-haiku-5-5

# ── Supabase (auth + database) ───────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Chiave SEGRETA: Supabase → Project Settings → API Keys → Secret keys. Solo sul server, mai nel frontend.
SUPABASE_SECRET_KEY=

# ── Stripe ───────────────────────────────────────────────────────────────
# Stripe → Developers → API keys. Usa prima la chiave di test (sk_test_...).
STRIPE_SECRET_KEY=
# In locale: "stripe listen --forward-to localhost:3001/api/stripe/webhook" stampa questo valore (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Origini web autorizzate, separate da virgola
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:8081
